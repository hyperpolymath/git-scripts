{
  "name": "git-scripts-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server.mjs\" \"affinescript build -w\" \"vite\"",
    "dev:api": "node server.mjs",
    "dev:ui": "affinescript build -w",
    "build": "affinescript build && vite build",
    "check": "affinescript build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@affinescript/core": "^1.6.1",
    "@affinescript/runtime": "^12.0.0",
    "affinescript-tea": "file:../../affinescript-tea"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "affinescript": "^12.0.0",
    "vite": "^8.0.8"
  }
}
